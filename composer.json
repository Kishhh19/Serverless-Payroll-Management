{
    "name": "academic/serverless-payroll-api",
    "description": "Serverless Payroll Management API Using PHP and AWS Lambda",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bref/bref": "^2.1",
        "aws/aws-sdk-php": "^3.300",
        "dompdf/dompdf": "^3.0",
        "bramus/router": "~1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PayrollApi\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
